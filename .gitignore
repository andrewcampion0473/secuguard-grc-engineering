# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Evidence collected on your machine stays out of Git. The copy of record lives in S3.
/evidence/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Editors and OS
.vscode/
.DS_Store
Thumbs.db

# A report saved with 'secuguard report --markdown'. It names your account.
/report.md
/report.html

# A saved Terraform plan. It can contain secrets.
terraform/tfplan
/ksi-report.md

# Where this computer finds the Terraform state bucket, and the backend switch itself.
# Both are specific to one AWS account. See docs/automate/block-noncompliant-changes.md.
terraform/backend.tf
terraform/backend.hcl

# A throwaway practice folder, if you collect into one with --output demo.
/demo/

# The manual built as a website with "mkdocs build".
/site/
